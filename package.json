{
  "name": "papercuts-skill",
  "version": "0.1.0",
  "private": false,
  "description": "A small agent skill and TypeScript CLI for recording workflow papercuts.",
  "type": "module",
  "bin": {
    "papercuts": "./dist/skills/agent-tools/papercuts/scripts/papercuts.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
